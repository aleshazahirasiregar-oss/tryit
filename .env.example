# Salin file ini jadi .env dan isi nilainya sebelum menjalankan aplikasi

# Database PostgreSQL (bisa pakai Supabase, Neon, Railway, atau server sendiri)
DATABASE_URL=postgres://user:password@localhost:5432/cashback_db

# Kunci rahasia untuk menandatangani session/JWT — ganti dengan string acak panjang
JWT_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak

# Port server
PORT=3000

# Xendit — dipakai untuk mencairkan saldo user ke rekening bank / e-wallet asli
# Daftar & ambil API key di https://dashboard.xendit.co (perlu verifikasi bisnis/KYB)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxx

# Minimal & maksimal nominal penarikan (dalam Rupiah)
MIN_WITHDRAW=25000
MAX_WITHDRAW=2000000

# Mode pencairan: "auto" (langsung panggil Xendit) atau "manual" (admin proses manual)
DISBURSEMENT_MODE=manual
